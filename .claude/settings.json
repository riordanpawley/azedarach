{
  "initCommands": [
    "direnv allow"
  ],
  "permissions": {
    "allow": [
      "Read(//**/.beads/images/**)",
      "Read(//**/.linear/images/**)",
      "Bash(az:*)",
      "mcp__effect-docs__*",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(gh:*)",
      "Bash(bun run type-check:*)",
      "Bash(bun run fix:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit-type-safety.cjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/linear-hooks.cjs session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/linear-hooks.cjs stop"
          }
        ]
      }
    ]
  }
}

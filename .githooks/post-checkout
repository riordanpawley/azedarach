#!/usr/bin/env sh
# Migrated from bd hook shim to explicit br behavior.
if [ "${3:-0}" = "1" ]; then
  if [ ! -d .git/rebase-merge ] && [ ! -d .git/rebase-apply ]; then
    if [ -d .beads ] && command -v br >/dev/null 2>&1; then
      br sync --import-only >/dev/null 2>&1 || true
      br doctor >/dev/null 2>&1 || true
    fi
  fi
fi


exit 0

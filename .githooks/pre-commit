#!/usr/bin/env sh
# >>> azedarach managed githook >>>
az githooks hook --hook pre-commit "$@" >/dev/null 2>&1 || true
# <<< azedarach managed githook <<<

set -eu

if [ "${AZEDARACH_SKIP_BOUNDARY_CHECK:-0}" = "1" ]; then
  echo "pre-commit: boundary validation advice skipped (AZEDARACH_SKIP_BOUNDARY_CHECK=1)"
  exit 0
fi

advise_boundary_check=0

while IFS= read -r path; do
  case "$path" in
    internal/*|cmd/*|docs/*|justfile|AGENTS.md|.githooks/*|.golangci-boundary.yml|scripts/check-boundaries.sh|scripts/afv-drift-sentinel.sh)
      advise_boundary_check=1
      break
      ;;
  esac
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR)
EOF

if [ "$advise_boundary_check" = "1" ]; then
  echo "pre-commit: boundary-sensitive files staged; run 'just check-boundaries' before review"
fi

exit 0

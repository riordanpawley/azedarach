# List available commands
default:
    @just --list

build:
    ../bin/go build -o bin/az ./cmd/az
    ../bin/go build -o bin/azd ./cmd/azd

run:
    ../bin/go build -o bin/azd ./cmd/azd
    ../bin/go run ./cmd/az

test:
    ../bin/go test -v ./...

test-coverage:
    ../bin/go test -coverprofile=coverage.out ./...
    ../bin/go tool cover -html=coverage.out -o coverage.html

type-check:
    ../bin/go build ./...

clean:
    rm -rf bin/ coverage.out coverage.html

install:
    ../bin/go install ./cmd/az

lint:
    golangci-lint run ./...

boundary-check:
    if command -v golangci-lint >/dev/null 2>&1; then golangci-lint run --config .golangci-boundary.yml ./internal/...; else echo "WARN: golangci-lint not installed; skipping depguard boundary lint gate" >&2; fi
    ./scripts/check-go-boundaries.sh
    ../scripts/afv-drift-sentinel.sh
    ../bin/go test ./internal/app ./internal/cli
    ../bin/go test ./internal/daemon/... ./internal/client/...

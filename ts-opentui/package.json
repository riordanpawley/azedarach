{
	"name": "azedarach",
	"version": "0.4.4",
	"description": "TUI Kanban board for orchestrating parallel Claude Code sessions",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"manypkg": {
		"ignoredRules": [
			"ROOT_HAS_PROD_DEPENDENCIES"
		]
	},
	"bin": {
		"az": "./bin/az"
	},
	"scripts": {
		"dev": "bun run packages/entry/src/main.ts",
		"dev:watch": "AZ_NO_TMUX=1 bun --watch run packages/entry/src/main.ts",
		"workspace:install": "bun install",
		"typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
		"clean": "rm -rf dist packages/*/dist tsconfig.tsbuildinfo packages/*/dist/tsconfig.tsbuildinfo dist/tsconfig.tsbuildinfo",
		"link": "mkdir -p \"$HOME/.local/bin\" && ln -sf \"$(pwd)/bin/az\" \"$HOME/.local/bin/az\"",
		"build": "bun build packages/entry/src/main.ts --outfile ./bin/az.ts --target bun",
		"build-sfe": "bun build packages/entry/src/main.ts --compile --outfile ./bin/az",
		"check:deps": "manypkg check",
		"check:boundaries": "bash scripts/check-package-boundaries.sh",
		"check:ci": "bun run lint && bun run typecheck && bun run check:deps && bun run check:boundaries",
		"lint": "biome lint src bin packages",
		"format": "biome format --write src bin packages",
		"check": "biome check --write src bin packages",
		"fix": "biome check --write .",
		"prepare": "git config core.hooksPath .githooks && effect-tsgo patch",
		"codanna:index": "cd .. && codanna --config .codanna/settings.toml index",
		"postinstall": "if [ \"${CI:-}\" != \"true\" ]; then bun run codanna:index; fi"
	},
	"keywords": [
		"tui",
		"kanban",
		"claude",
		"orchestration"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@azedarach/shared": "workspace:*",
		"@effect-atom/atom": "latest",
		"@effect-atom/atom-react": "latest",
		"@effect/cli": "0.72.1",
		"@effect/cluster": "0.55.0",
		"@effect/experimental": "0.58.0",
		"@effect/opentelemetry": "0.61.0",
		"@effect/platform": "0.93.6",
		"@effect/platform-bun": "0.86.0",
		"@linear/sdk": "^76.0.0",
		"@opentui/core": "latest",
		"@opentui/react": "latest",
		"effect": "3.19.11",
		"react": "^19.0.0",
		"terminal-image": "^4.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.7",
		"@effect/tsgo": "0.0.15",
		"@effect/vitest": "0.27.0",
		"@manypkg/cli": "^0.25.1",
		"@types/bun": "latest",
		"@types/react": "^19.2.7",
		"@typescript/native-preview": "^7.0.0-dev.20260319.1",
		"tsup": "latest",
		"typescript": "latest",
		"vitest": "^4.0.18"
	}
}

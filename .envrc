# Share nix-direnv's external profile cache across this repository's worktrees.
# direnv and nix-direnv use this supported hook when choosing their layout path.
direnv_layout_dir() {
  local cache_root git_common_dir layout_key

  cache_root="${XDG_CACHE_HOME:-$HOME/.cache}"
  git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || pwd -P)"
  layout_key="$(printf '%s\n' "$git_common_dir" | git hash-object --stdin)"

  printf '%s/direnv/layouts/azedarach-%s\n' "$cache_root" "$layout_key"
}

# Only use Nix flake if Nix is installed
if command -v nix &> /dev/null; then
  # A shared cache deliberately avoids per-worktree rebuilds. Reload explicitly
  # with `nix-direnv-reload` after changing flake.nix or flake.lock.
  if [ "${AZEDARACH_DIRENV_MANUAL_NIX_RELOAD:-1}" != "0" ] && type nix_direnv_manual_reload &> /dev/null; then
    if compgen -G "$(direnv_layout_dir)/flake-profile-*.rc" > /dev/null; then
      nix_direnv_manual_reload
    fi
  fi

  use flake
else
  echo "Nix not found, skipping flake setup"
fi

PROJECT_ROOT="$(pwd -P)"

# Repo-local, scratch, and package-manager bin directories may contain stale
# az/azd binaries alongside unrelated tools. Preserve every inherited PATH
# entry, resolve only an installer-owned active control chain, and prepend its
# immutable generation so bare az/azd are coherent without hiding other tools.

azedarach_resolve_executable() {
  local target link directory hops
  target="$1"
  hops=0
  while [ -L "$target" ]; do
    hops=$((hops + 1))
    [ "$hops" -le 40 ] || return 1
    link="$(readlink "$target")" || return 1
    case "$link" in
      /*) target="$link" ;;
      *) target="$(dirname "$target")/$link" ;;
    esac
  done
  directory="$(CDPATH= cd -P -- "$(dirname "$target")" 2>/dev/null && pwd)" || return 1
  printf '%s/%s\n' "$directory" "$(basename "$target")"
}

AZEDARACH_MANAGED_GENERATION=""
AZEDARACH_PATH_IFS="$IFS"
IFS=:
for AZEDARACH_PATH_ENTRY in $PATH; do
  [ -n "$AZEDARACH_PATH_ENTRY" ] || continue
  if [ -x "$AZEDARACH_PATH_ENTRY/az" ] || [ -x "$AZEDARACH_PATH_ENTRY/azd" ]; then
    AZEDARACH_AZ_TARGET="$(azedarach_resolve_executable "$AZEDARACH_PATH_ENTRY/az" 2>/dev/null || true)"
    AZEDARACH_AZD_TARGET="$(azedarach_resolve_executable "$AZEDARACH_PATH_ENTRY/azd" 2>/dev/null || true)"
    AZEDARACH_GENERATION_DIR="$(dirname "$AZEDARACH_AZ_TARGET")"
    AZEDARACH_GENERATION_NAME="$(basename "$AZEDARACH_GENERATION_DIR")"
    AZEDARACH_INSTALL_ROOT="$(dirname "$(dirname "$AZEDARACH_GENERATION_DIR")")"
    AZEDARACH_CONTROLLED_ENTRY=0
    if [ "$AZEDARACH_PATH_ENTRY" = "$AZEDARACH_INSTALL_ROOT" ] &&
      [ -L "$AZEDARACH_INSTALL_ROOT/.azedarach-current" ] &&
      [ "$(readlink "$AZEDARACH_PATH_ENTRY/az" 2>/dev/null || true)" = ".azedarach-current/az" ] &&
      [ "$(readlink "$AZEDARACH_PATH_ENTRY/azd" 2>/dev/null || true)" = ".azedarach-current/azd" ]; then
      AZEDARACH_CONTROLLED_ENTRY=1
    elif [ "$AZEDARACH_PATH_ENTRY" = "$AZEDARACH_GENERATION_DIR" ] &&
      [ -L "$AZEDARACH_INSTALL_ROOT/.azedarach-current" ] &&
      [ "$(readlink "$AZEDARACH_INSTALL_ROOT/az" 2>/dev/null || true)" = ".azedarach-current/az" ] &&
      [ "$(readlink "$AZEDARACH_INSTALL_ROOT/azd" 2>/dev/null || true)" = ".azedarach-current/azd" ] &&
      [ "$(azedarach_resolve_executable "$AZEDARACH_INSTALL_ROOT/az" 2>/dev/null || true)" = "$AZEDARACH_AZ_TARGET" ] &&
      [ "$(azedarach_resolve_executable "$AZEDARACH_INSTALL_ROOT/azd" 2>/dev/null || true)" = "$AZEDARACH_AZD_TARGET" ]; then
      AZEDARACH_CONTROLLED_ENTRY=1
    fi
    if [ "$AZEDARACH_CONTROLLED_ENTRY" -eq 1 ] &&
      [ "$AZEDARACH_AZ_TARGET" = "$AZEDARACH_GENERATION_DIR/az" ] &&
      [ "$AZEDARACH_AZD_TARGET" = "$AZEDARACH_GENERATION_DIR/azd" ] &&
      [ "$(basename "$(dirname "$AZEDARACH_GENERATION_DIR")")" = ".azedarach-generations" ] &&
      [ -n "${AZEDARACH_GENERATION_NAME#generation.}" ] &&
      [ "${AZEDARACH_GENERATION_NAME#generation.}" != "$AZEDARACH_GENERATION_NAME" ] &&
      [ -x "$AZEDARACH_AZ_TARGET" ] && [ -x "$AZEDARACH_AZD_TARGET" ] &&
      [ -z "$AZEDARACH_MANAGED_GENERATION" ]; then
      AZEDARACH_MANAGED_GENERATION="$AZEDARACH_GENERATION_DIR"
      break
    fi
  fi
done
IFS="$AZEDARACH_PATH_IFS"
if [ -n "$AZEDARACH_MANAGED_GENERATION" ]; then
  PATH_add "$AZEDARACH_MANAGED_GENERATION"
else
  echo "ERROR: no active installer-managed az/azd generation found; run 'just build-install-run --no-run' from the primary worktree, then reload direnv"
fi
unset -f azedarach_resolve_executable
unset AZEDARACH_AZ_TARGET AZEDARACH_AZD_TARGET AZEDARACH_CONTROLLED_ENTRY AZEDARACH_GENERATION_DIR AZEDARACH_GENERATION_NAME AZEDARACH_INSTALL_ROOT AZEDARACH_MANAGED_GENERATION AZEDARACH_PATH_ENTRY AZEDARACH_PATH_IFS

# Keep module downloads shared, but isolate compiled objects by lifecycle and
# instrumentation mode. The cache roots live with the repository family rather
# than inside checkout-local untracked directories.
source "$PROJECT_ROOT/scripts/go-cache-env.sh"

# Load .env.local if present (personal local overrides)
if [ -f .env.local ]; then
  watch_file .env.local
  dotenv .env.local
  echo "Loaded .env.local"
fi

# Default issue backend for this repo is linear.
export ISSUE_BACKEND="${ISSUE_BACKEND:-linear}"

# Optional machine-local overrides (untracked).
source_env_if_exists .envrc.local

# Local loaders run after the initial defaults, so finalize cache routing again.
# This rejects any root/namespace redirect introduced by either local file.
source "$PROJECT_ROOT/scripts/go-cache-env.sh" --finalize

# Check the selected backend tool.
case "${ISSUE_BACKEND}" in
  linear)
    if ! command -v linear-cli &> /dev/null; then
      echo "WARNING: ISSUE_BACKEND=linear but linear-cli is not installed"
    fi
    ;;
  az)
    if ! command -v az &> /dev/null; then
      echo "WARNING: ISSUE_BACKEND=az but az is not installed"
    fi
    ;;
  br)
    if ! command -v br &> /dev/null; then
      echo "WARNING: ISSUE_BACKEND=br but br is not installed"
    fi
    ;;
  bd)
    if ! command -v bd &> /dev/null; then
      echo "WARNING: ISSUE_BACKEND=bd but bd is not installed"
    fi
    ;;
  *)
    echo "WARNING: unknown ISSUE_BACKEND=${ISSUE_BACKEND} (expected linear|az|br|bd)"
    ;;
esac

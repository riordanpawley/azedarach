# Only use Nix flake if Nix is installed
if command -v nix &> /dev/null; then
  use flake
else
  echo "Nix not found, skipping flake setup"
fi

# Ensure local Effect reference repo is available for tooling lookups.
PROJECT_ROOT="$(pwd -P)"
EFFECT_SOURCE="$HOME/prog/effect"
EFFECT_LINK="$PROJECT_ROOT/reference-effect"

if [ -d "$EFFECT_SOURCE" ]; then
  EFFECT_SOURCE_REAL="$(cd "$EFFECT_SOURCE" && pwd -P)"
  if [ -L "$EFFECT_LINK" ]; then
    EFFECT_LINK_REAL="$(cd "$EFFECT_LINK" 2>/dev/null && pwd -P || true)"
    if [ "$EFFECT_LINK_REAL" != "$EFFECT_SOURCE_REAL" ]; then
      ln -sfn "$EFFECT_SOURCE_REAL" "$EFFECT_LINK"
    fi
  elif [ ! -e "$EFFECT_LINK" ]; then
    ln -s "$EFFECT_SOURCE_REAL" "$EFFECT_LINK"
  fi
fi

# Expose helper commands from ./bin.
PATH_add bin

# Go cache/module paths: keep artifacts inside repo to avoid sandbox/home-dir failures.
GO_WORKSPACE_ROOT="$PROJECT_ROOT"
export GOCACHE="${GOCACHE:-$GO_WORKSPACE_ROOT/.gocache}"
export GOPATH="${GOPATH:-$GO_WORKSPACE_ROOT/.gopath}"
mkdir -p "$GOCACHE" "$GOPATH"

# Load .env.local if present (personal local overrides)
if [ -f .env.local ]; then
  watch_file .env.local
  dotenv .env.local
  echo "Loaded .env.local"
fi

# Default issue backend for this repo is linear.
export ISSUE_BACKEND="${ISSUE_BACKEND:-linear}"

# Optional machine-local overrides (untracked).
source_env_if_exists .envrc.local

# Check the selected backend tool.
case "${ISSUE_BACKEND}" in
  linear)
    if ! command -v linear-cli &> /dev/null; then
      echo "WARNING: ISSUE_BACKEND=linear but linear-cli is not installed"
    fi
    ;;
  az)
    if ! command -v az &> /dev/null; then
      echo "WARNING: ISSUE_BACKEND=az but az is not installed"
    fi
    ;;
  br)
    if ! command -v br &> /dev/null; then
      echo "WARNING: ISSUE_BACKEND=br but br is not installed"
    fi
    ;;
  bd)
    if ! command -v bd &> /dev/null; then
      echo "WARNING: ISSUE_BACKEND=bd but bd is not installed"
    fi
    ;;
  *)
    echo "WARNING: unknown ISSUE_BACKEND=${ISSUE_BACKEND} (expected linear|az|br|bd)"
    ;;
esac

# Only use Nix flake if Nix is installed
if command -v nix &> /dev/null; then
  use flake
else
  echo "Nix not found, skipping flake setup"
fi

# Load .env.local if present (personal local overrides)
if [ -f .env.local ]; then
  watch_file .env.local
  dotenv .env.local
  echo "Loaded .env.local"
fi

# Set beads workspace directory for MCP plugin
# This ensures beads MCP tools can find the workspace without manual set_context() calls
export BEADS_WORKING_DIR="$PWD"

# Compatibility shims:
# - temporary workaround for a br auto-flush bug on mutating commands
# - remove this shim once the bug is fixed in br
# - inject --no-auto-flush/--no-auto-import for read and mutating operations
# - route legacy bd calls to br inside this project shell
BEADS_SHIM_DIR="$PWD/.direnv/bin"
mkdir -p "$BEADS_SHIM_DIR"

REAL_BR_PATH=""
IFS=':'
for path_entry in $PATH; do
  if [ "$path_entry" = "$BEADS_SHIM_DIR" ]; then
    continue
  fi
  if [ -x "$path_entry/br" ]; then
    REAL_BR_PATH="$path_entry/br"
    break
  fi
done
unset IFS

if [ -n "$REAL_BR_PATH" ]; then
  BR_SHIM_PATH="$BEADS_SHIM_DIR/br"
  cat > "$BR_SHIM_PATH" <<EOF
#!/usr/bin/env bash
# Temporary workaround for a br auto-flush bug.
# Remove this wrapper once the bug is fixed in br.
# We inject --no-auto-flush and --no-auto-import for read and mutating commands.
set -euo pipefail

real_br="$REAL_BR_PATH"
cmd=""
skip_next=0

# Parse global options to find the first subcommand token.
for arg in "\$@"; do
  if [ "\$skip_next" -eq 1 ]; then
    skip_next=0
    continue
  fi

  case "\$arg" in
    --db|--actor|--lock-timeout)
      skip_next=1
      ;;
    --db=*|--actor=*|--lock-timeout=*)
      ;;
    --json|--no-daemon|--no-auto-flush|--no-auto-import|--allow-stale|--no-db|--quiet|--no-color|--help|--version|-q|-h|-V|-v|-vv|-vvv)
      ;;
    -*)
      # Unknown global flags are ignored for command detection.
      ;;
    *)
      cmd="\$arg"
      break
      ;;
  esac
done

needs_no_auto_sync_flags=0
case "\$cmd" in
  agents|blocked|changelog|count|doctor|graph|history|info|lint|list|orphans|query|ready|schema|search|show|stale|stats|status|where|create|delete|dep|epic|comments|undefer|defer|update|close|reopen|q|label)
    needs_no_auto_sync_flags=1
    ;;
esac

if [ "\$needs_no_auto_sync_flags" -eq 1 ]; then
  has_no_auto_flush=0
  has_no_auto_import=0
  for arg in "\$@"; do
    if [ "\$arg" = "--no-auto-flush" ]; then
      has_no_auto_flush=1
    fi
    if [ "\$arg" = "--no-auto-import" ]; then
      has_no_auto_import=1
    fi
  done

  if [ "\$has_no_auto_flush" -eq 0 ]; then
    set -- --no-auto-flush "\$@"
  fi
  if [ "\$has_no_auto_import" -eq 0 ]; then
    set -- --no-auto-import "\$@"
  fi
fi

exec "\$real_br" "\$@"
EOF
  chmod +x "$BR_SHIM_PATH"
  PATH_add "$BEADS_SHIM_DIR"

  if ! command -v bd &> /dev/null; then
    BD_SHIM_PATH="$BEADS_SHIM_DIR/bd"
    cat > "$BD_SHIM_PATH" <<'EOF'
#!/usr/bin/env bash
exec br "$@"
EOF
    chmod +x "$BD_SHIM_PATH"
  fi
fi

# Disable beads daemon to prevent race conditions with multiple Claude sessions
# See az-9co for details on the bd sync race condition bug
export BEADS_NO_DAEMON=1

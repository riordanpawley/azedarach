# Share nix-direnv's external profile cache across this repository's worktrees.
# direnv and nix-direnv use this supported hook when choosing their layout path.
direnv_layout_dir() {
  local cache_root git_common_dir layout_key

  cache_root="${XDG_CACHE_HOME:-$HOME/.cache}"
  git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || pwd -P)"
  layout_key="$(printf '%s\n' "$git_common_dir" | git hash-object --stdin)"

  printf '%s/direnv/layouts/azedarach-%s\n' "$cache_root" "$layout_key"
}

# Only use Nix flake if Nix is installed
if command -v nix &> /dev/null; then
  # A shared cache deliberately avoids per-worktree rebuilds. Reload explicitly
  # with `nix-direnv-reload` after changing flake.nix or flake.lock.
  if [ "${AZEDARACH_DIRENV_MANUAL_NIX_RELOAD:-1}" != "0" ] && type nix_direnv_manual_reload &> /dev/null; then
    if compgen -G "$(direnv_layout_dir)/flake-profile-*.rc" > /dev/null; then
      nix_direnv_manual_reload
    fi
  fi

  use flake
else
  echo "Nix not found, skipping flake setup"
fi

PROJECT_ROOT="$(pwd -P)"

# Expose helper commands from ./bin.
PATH_add bin

# Go cache/module paths: keep artifacts inside the repo family to avoid
# sandbox/home-dir failures without duplicating multi-GB caches per worktree.
GIT_COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
if [ -n "$GIT_COMMON_DIR" ] && [ "$(basename "$GIT_COMMON_DIR")" = ".git" ]; then
  GO_CACHE_ROOT="$(dirname "$GIT_COMMON_DIR")/.azedarach/go"
else
  GO_CACHE_ROOT="$PROJECT_ROOT/.azedarach/go"
fi
AZEDARACH_GO_CACHE_ROOT="${AZEDARACH_GO_CACHE_ROOT:-$GO_CACHE_ROOT}"
export GOCACHE="${AZEDARACH_GOCACHE:-$AZEDARACH_GO_CACHE_ROOT/build-cache}"
export GOPATH="${AZEDARACH_GOPATH:-$AZEDARACH_GO_CACHE_ROOT/path}"
mkdir -p "$GOCACHE" "$GOPATH"

# Load .env.local if present (personal local overrides)
if [ -f .env.local ]; then
  watch_file .env.local
  dotenv .env.local
  echo "Loaded .env.local"
fi

# Default issue backend for this repo is linear.
export ISSUE_BACKEND="${ISSUE_BACKEND:-linear}"

# Optional machine-local overrides (untracked).
source_env_if_exists .envrc.local

# Check the selected backend tool.
case "${ISSUE_BACKEND}" in
  linear)
    if ! command -v linear-cli &> /dev/null; then
      echo "WARNING: ISSUE_BACKEND=linear but linear-cli is not installed"
    fi
    ;;
  az)
    if ! command -v az &> /dev/null; then
      echo "WARNING: ISSUE_BACKEND=az but az is not installed"
    fi
    ;;
  br)
    if ! command -v br &> /dev/null; then
      echo "WARNING: ISSUE_BACKEND=br but br is not installed"
    fi
    ;;
  bd)
    if ! command -v bd &> /dev/null; then
      echo "WARNING: ISSUE_BACKEND=bd but bd is not installed"
    fi
    ;;
  *)
    echo "WARNING: unknown ISSUE_BACKEND=${ISSUE_BACKEND} (expected linear|az|br|bd)"
    ;;
esac

{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "~/.config/opencode/plugin/shell-strategy/shell_strategy.md"
  ],
  "plugin": [
    "@nick-vi/opencode-type-inject",
    "opencode-pty"
  ],
  "model": "openai/gpt-5.3-codex",
  "disabled_providers": [
    "anthropic"
  ],
  "permission": {
    "bash": {
      "rg * | head *": "allow",
      "rg * | tail *": "allow",
      "rg * | *": "allow",
      "rg *": "allow",
      "fd * | head *": "allow",
      "fd * | tail *": "allow",
      "fd * | *": "allow",
      "fd *": "allow",
      "ls * | head *": "allow",
      "ls * | tail *": "allow",
      "ls * | *": "allow",
      "ls *": "allow",
      "git log * | head *": "allow",
      "git log * | tail *": "allow",
      "git log * | *": "allow",
      "git log": "allow",
      "git status | *": "allow",
      "git status": "allow",
      "git diff | *": "allow",
      "git diff *": "allow",
      "git diff": "allow",
      "git branch | *": "allow",
      "git branch *": "allow",
      "git branch": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "bun run type-check *": "allow",
      "bun run type-check": "allow",
      "bun run dev *": "allow",
      "bun run build *": "allow",
      "bun run build": "allow",
      "bun *": "allow",
      "az": "allow",
      "az *": "allow",
      "tmux *": "allow"
    }
  },
  "mcp": {
    "effect-docs": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "effect-mcp@latest"
      ],
      "enabled": true
    },
    "codanna": {
      "type": "local",
      "command": [
        "codanna",
        "--config",
        ".codanna/settings.toml",
        "serve",
        "--watch"
      ],
      "enabled": true
    }
  }
}

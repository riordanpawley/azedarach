#!/usr/bin/env perl
use strict;
use warnings;
use Fcntl qw(F_GETFD F_SETFD FD_CLOEXEC);
use File::Basename qw(basename);
use File::Temp qw(tempfile);
use File::Path qw(remove_tree);
use IO::Select;
use JSON::PP qw(decode_json encode_json);
use Digest::SHA qw(sha256_hex);
use POSIX qw(:sys_wait_h setpgid);
use Socket qw(AF_UNIX SOCK_STREAM PF_UNSPEC);
use Time::HiRes qw(time sleep);

my $mode = 'run';
my $class = 'shared';
my $profile = '';
my $scope = '';
my $purpose = '';
my $override = 'none';
my $override_actor = '';
my $override_reason = '';
my $command_identity = '';
my $isolation_identity = '';
my $interval = 1;
while (@ARGV && $ARGV[0] ne '--') {
    my $flag = shift @ARGV;
    if ($flag eq '--status') { $mode = 'status'; next; }
    if ($flag eq '--watch') { $mode = 'watch'; next; }
    if ($flag eq '--interval') { $interval = shift(@ARGV) // die "--interval requires seconds\n"; next; }
    if ($flag eq '--class') { $class = shift(@ARGV) // die "--class requires a value\n"; next; }
    if ($flag eq '--scope') { $scope = shift(@ARGV) // die "--scope requires a value\n"; next; }
    if ($flag eq '--purpose') { $purpose = shift(@ARGV) // die "--purpose requires a value\n"; next; }
    if ($flag eq '--no-reuse') { die "validation override already selected\n" unless $override eq 'none'; $override = 'no_reuse'; next; }
    if ($flag eq '--force-rerun') { die "validation override already selected\n" unless $override eq 'none'; $override = 'force_rerun'; next; }
    if ($flag eq '--emergency-skip') { die "validation override already selected\n" unless $override eq 'none'; $override = 'emergency_skip'; $override_reason = shift(@ARGV) // die "--emergency-skip requires a reason\n"; next; }
    if ($flag eq '--override-actor') { $override_actor = shift(@ARGV) // die "--override-actor requires a value\n"; next; }
    if ($flag eq '--command-identity') { $command_identity = shift(@ARGV) // die "--command-identity requires a value\n"; next; }
    if ($flag eq '--isolation-identity') { $isolation_identity = shift(@ARGV) // die "--isolation-identity requires a value\n"; next; }
    if ($flag eq '--label' || $flag eq '--profile') { $profile = shift(@ARGV) // die "$flag requires a value\n"; next; }
    die "unknown option $flag\n";
}
shift @ARGV if @ARGV && $ARGV[0] eq '--';
die "unsupported validation class $class\n" unless $class eq 'aggregate' || $class eq 'shared' || $class eq 'safe';
$override = 'emergency_skip' if $override eq 'none' && ($ENV{AZEDARACH_VALIDATION_EMERGENCY_SKIP_REASON} || '') ne '';
$override_reason ||= $ENV{AZEDARACH_VALIDATION_EMERGENCY_SKIP_REASON} || '';
$override_actor ||= $ENV{AZEDARACH_VALIDATION_OVERRIDE_ACTOR} || '';
die "--override-actor is only valid with --emergency-skip\n" if $override ne 'emergency_skip' && $override_actor ne '';
if ($override eq 'emergency_skip') {
    $override_actor ||= $ENV{AZEDARACH_AUDIT_ACTOR} || $ENV{USER} || $ENV{LOGNAME} || '';
    die "emergency validation skip requires an explicit actor\n" if $override_actor eq '';
}
my $control_az = $ENV{AZEDARACH_VALIDATION_CONTROL_AZ_BIN}
    || $ENV{AZEDARACH_VALIDATION_AZ_BIN}
    || 'az';
my $cleanup_az = $ENV{AZEDARACH_VALIDATION_CLEANUP_AZ_BIN} || '';
my $git = $ENV{AZEDARACH_VALIDATION_GIT_BIN} || 'git';
my $daemon_scope = lc($ENV{AZEDARACH_DAEMON_SCOPE} || '');
my $daemon_scope_source = lc($ENV{AZEDARACH_DAEMON_SCOPE_SOURCE} || '');
my $cleanup_scoped_daemon = ($daemon_scope eq 'worktree' || $daemon_scope eq 'scoped' || $daemon_scope eq 'local')
    && $daemon_scope_source ne 'just-run'
    && $mode eq 'run'
    && !$ENV{AZEDARACH_VALIDATION_REQUEST_ID};
my $scoped_cleanup_owner_pid = $$;
my $scoped_cleanup_done = 0;
my $scoped_cleanup_timeout = $ENV{AZEDARACH_VALIDATION_CLEANUP_TIMEOUT_SECONDS} || 20;
my $scoped_cleanup_watchdog = $ENV{AZEDARACH_VALIDATION_TEST_CLEANUP_WATCHDOG_FILE} || '';
if ($cleanup_scoped_daemon) {
    die "AZEDARACH_VALIDATION_CLEANUP_TIMEOUT_SECONDS must be positive seconds\n"
        unless $scoped_cleanup_timeout =~ /^\d+(?:\.\d+)?$/ && $scoped_cleanup_timeout > 0;
}
if ($cleanup_scoped_daemon && $cleanup_az eq '') {
    $scoped_cleanup_done = 1;
    die "worktree-scoped validation requires AZEDARACH_VALIDATION_CLEANUP_AZ_BIN\n";
}
my $stop_scoped_daemon = sub {
    return 1 unless $$ == $scoped_cleanup_owner_pid && $cleanup_scoped_daemon && !$scoped_cleanup_done;
    $scoped_cleanup_done = 1;
    local %ENV = %ENV;
    clear_control_authority_environment();
    my $stop_status = bounded_cleanup_system($cleanup_az, $scoped_cleanup_timeout, $scoped_cleanup_watchdog, 'daemon', 'stop');
    if ($stop_status != 0) {
        my $detail = $stop_status == -1 ? $! : $stop_status == -2 ? 'operational timeout' : 'exit ' . wait_status_code($stop_status);
        warn "worktree-scoped validation daemon cleanup failed: $detail\n";
        return 0;
    }
    return 1;
};

# The outer run-mode wrapper owns explicitly worktree-scoped daemons. Register
# cleanup before the first daemon request so acquire errors and handled signals
# cannot leave a detached azd behind.
END {
    if ($$ == $scoped_cleanup_owner_pid && $cleanup_scoped_daemon && !$scoped_cleanup_done) {
        my $original_status = $?;
        $original_status = 70 if !$stop_scoped_daemon->() && $original_status == 0;
        $? = $original_status;
    }
}
my %preflight_signal_exit = (HUP => 129, INT => 130, TERM => 143);
$SIG{TERM} = sub { exit $preflight_signal_exit{TERM} };
$SIG{INT} = sub { exit $preflight_signal_exit{INT} };
$SIG{HUP} = sub { exit $preflight_signal_exit{HUP} };

if ($mode eq 'status') {
    clear_candidate_routing_environment();
    exec $control_az, 'validation', 'status', '--json' or die "exec validation status: $!\n";
}
if ($mode eq 'watch') {
    clear_candidate_routing_environment();
    exec $control_az, 'validation', 'watch', '--json', '--interval', $interval . 's' or die "exec validation watch: $!\n";
}
die "usage: with-machine-validation-lease [--status|--watch] | --class aggregate|shared|safe --profile name -- command [args]\n" unless @ARGV;

# Nested commands prove membership in the outer command tree with an inherited
# kernel descriptor. The public request id is insufficient, and the lease token
# is never present in the executed command environment or argv.
if ($ENV{AZEDARACH_VALIDATION_REQUEST_ID}) {
    die "nested validation cannot select an override outside the outer capability\n" unless $override eq 'none';
    my $fd = $ENV{AZEDARACH_VALIDATION_NESTED_FD};
    die "nested validation requires an inherited authorization capability\n" unless defined($fd) && $fd =~ /^\d+$/;
    open my $broker, '+<&=', $fd or die "attach nested validation authorization capability: $!\n";
    $broker->autoflush(1);
    my $nested_flags = fcntl($broker, F_GETFD, 0);
    die "read nested validation capability flags: $!\n" unless defined $nested_flags;
    fcntl($broker, F_SETFD, $nested_flags & ~FD_CLOEXEC)
        or die "preserve nested validation capability across exec: $!\n";
    my $nonce = random_token();
    $scope ||= $ENV{AZEDARACH_VALIDATION_SCOPE} || '';
    $purpose ||= $ENV{AZEDARACH_VALIDATION_PURPOSE} || '';
    print {$broker} encode_json({request_id => $ENV{AZEDARACH_VALIDATION_REQUEST_ID}, class => $class, scope => $scope, purpose => $purpose, nonce => $nonce}) . "\n"
        or die "request nested validation authorization: $!\n";
    my $line = <$broker>;
    die "nested validation authorization broker closed\n" unless defined $line;
    my $authorization = eval { decode_json($line) };
    die "nested validation authorization returned invalid response\n" unless $authorization && ($authorization->{nonce} || '') eq $nonce;
    die(($authorization->{error} || 'nested validation authorization rejected') . "\n") unless $authorization->{ok};
    $ENV{AZEDARACH_VALIDATION_CLASS} = $authorization->{class};
    $ENV{AZEDARACH_VALIDATION_PROFILE} = $authorization->{profile};
    $ENV{AZEDARACH_VALIDATION_SOURCE_REVISION} = $authorization->{source_revision};
    $ENV{AZEDARACH_VALIDATION_SCOPE} = $authorization->{scope};
    $ENV{AZEDARACH_VALIDATION_PURPOSE} = $authorization->{purpose};
    exec @ARGV or die "exec nested validation command $ARGV[0]: $!\n";
}

my $issue = $ENV{AZEDARACH_TICKET_ID} || $ENV{AZEDARACH_ISSUE_ID} || '';
$scope ||= $ENV{AZEDARACH_VALIDATION_SCOPE} || ($issue ne '' ? 'ticket' : 'repository');
$purpose ||= $ENV{AZEDARACH_VALIDATION_PURPOSE} || ($scope eq 'repository' ? 'push_gate' : 'development');
die "unsupported validation scope $scope\n" unless $scope eq 'repository' || $scope eq 'ticket';
die "unsupported validation purpose $purpose\n" unless $purpose =~ /^(?:capacity|development|push_gate|review_evidence)$/;
die "repository-scoped validation must not identify a ticket\n" if $scope eq 'repository' && $issue ne '';
die "ticket-scoped validation requires AZEDARACH_TICKET_ID\n" if $scope eq 'ticket' && $issue eq '';

# Older worktrees may still invoke this wrapper for ordinary development.
# Preserve their command and scoped-daemon cleanup behavior without touching
# the daemon validation queue.
if ($purpose eq 'development') {
    my $payload = fork();
    die "fork unleased development command: $!\n" unless defined $payload;
    if ($payload == 0) {
        setpgid(0, 0);
        delete @ENV{qw(
            AZEDARACH_VALIDATION_CONTROL_AZ_BIN
            AZEDARACH_VALIDATION_AZ_BIN
            AZEDARACH_VALIDATION_CLEANUP_AZ_BIN
            AZEDARACH_VALIDATION_TEST_CLEANUP_WATCHDOG_FILE
        )};
        exec @ARGV or die "exec development command $ARGV[0]: $!\n";
    }
    eval { setpgid($payload, $payload) };
    my $forward = sub { my ($signal) = @_; kill $signal, -$payload if $payload; };
    local $SIG{TERM} = sub { $forward->('TERM') };
    local $SIG{INT} = sub { $forward->('INT') };
    local $SIG{HUP} = sub { $forward->('HUP') };
    my $payload_status = 0;
    while (1) {
        my $waited = waitpid($payload, WNOHANG);
        if ($waited == $payload) {
            $payload_status = $?;
            last;
        }
        sleep 0.1;
    }
    my $exit_code = wait_status_code($payload_status);
    $exit_code = 78 if !$stop_scoped_daemon->() && $exit_code == 0;
    exit $exit_code;
}
my $revision = capture($git, 'rev-parse', 'HEAD');
$revision =~ s/\s+\z//;
die "resolve validation source revision\n" unless $revision;
$profile ||= $class;
my $isolation_mode = $isolation_identity || ($daemon_scope eq 'worktree' ? 'worktree' : 'repository-family');
my $environment_fingerprint = $ENV{AZEDARACH_VALIDATION_ENVIRONMENT_FINGERPRINT} || sha256_hex(join("\0", map { $_ . '=' . ($ENV{$_} || '') } qw(PATH GOROOT GOFLAGS GOOS GOARCH GOTOOLCHAIN CGO_ENABLED CC CXX AZEDARACH_REAL_GO_BIN NIX_PROFILES)));
my $lease_token = random_token();
my $request_id = sprintf('%s-%d-%d-%s', $issue, $$, int(time() * 1_000_000), substr(random_token(), 0, 12));
$request_id =~ s/[^A-Za-z0-9_.-]/_/g;
my $git_common_dir = capture($git, 'rev-parse', '--path-format=absolute', '--git-common-dir');
$git_common_dir =~ s/\s+\z//;
die "resolve Git common directory for validation admission\n" unless $git_common_dir;
my $production_admission = "$git_common_dir/azedarach-production-admission";
my $production_owner = "$production_admission/production";
my $production_epoch_file = "$production_admission/production-epoch";
my $validation_participant = "$production_admission/validations/$request_id";
my $validation_pending = "$production_admission/pending/$request_id.$$";
my $production_wait_seconds = $ENV{AZEDARACH_VALIDATION_PRODUCTION_WAIT_SECONDS} || 15;
die "AZEDARACH_VALIDATION_PRODUCTION_WAIT_SECONDS must be a non-negative integer\n"
    unless $production_wait_seconds =~ /^\d+$/;
my $production_wait_started = time();
my $production_wait_reported = 0;
my $production_sensitive = $class eq 'aggregate' && ($purpose eq 'push_gate' || $purpose eq 'review_evidence') && $override ne 'emergency_skip';
if ($production_sensitive) {
system('mkdir', '-p', "$production_admission/validations", "$production_admission/pending") == 0
    or die "create validation admission directory\n";
while (1) {
    if (mkdir $validation_pending, 0700) {
        open my $pid_fh, '>', "$validation_pending/pid" or die "write validation admission pid: $!\n";
        print {$pid_fh} "$$\n";
        close $pid_fh;
        open my $reason_fh, '>', "$validation_pending/reason" or die "write validation admission reason: $!\n";
        print {$reason_fh} "$class validation $profile scope=$scope purpose=$purpose override=$override\n";
        close $reason_fh;
        rename $validation_pending, $validation_participant
            or die "publish validation admission participant: $!\n";
        last unless -d $production_owner;
        remove_tree($validation_participant);
    }
    if (-d $production_owner) {
        my $owner_pid = '';
        if (open my $owner_fh, '<', "$production_owner/pid") {
            $owner_pid = <$owner_fh> // '';
            close $owner_fh;
            $owner_pid =~ s/\s+\z//;
        }
        if ($owner_pid ne '' && ($owner_pid !~ /^\d+$/ || !kill(0, $owner_pid))) {
            remove_tree($production_owner);
            next;
        }
        if (!$production_wait_reported) {
            warn "Validation is waiting for production install admission (pid $owner_pid); timeout ${production_wait_seconds}s.\n";
            $production_wait_reported = 1;
        }
        die "Timed out waiting for production install admission after ${production_wait_seconds}s (pid $owner_pid).\n"
            if time() - $production_wait_started >= $production_wait_seconds;
    }
    sleep 0.1;
}
}
my $production_epoch_at_start = read_optional_file($production_epoch_file);
END {
    remove_tree($validation_participant) if defined($validation_participant) && -d $validation_participant;
    remove_tree($validation_pending) if defined($validation_pending) && -d $validation_pending;
}
$ENV{AZEDARACH_VALIDATION_LEASE_TOKEN} = $lease_token;
my $command_text = $command_identity || join(' ', @ARGV);
my @acquire = ($control_az, 'validation', 'acquire', '--request', $request_id, '--issue', $issue,
    '--class', $class, '--scope', $scope, '--purpose', $purpose, '--profile', $profile, '--command', $command_text,
    '--revision', $revision, '--isolation', $isolation_mode, '--environment-fingerprint', $environment_fingerprint,
    '--override', $override, '--ttl', '30', '--json');
push @acquire, '--override-actor', $override_actor, '--override-reason', $override_reason if $override eq 'emergency_skip';
my $acquired;
while (1) {
    my $decoded = eval { decode_json(control_capture(@acquire)) };
    die "validation acquire returned invalid JSON\n" unless $decoded && $decoded->{request}{state};
    $acquired = $decoded->{request};
    last if $acquired->{state} eq 'active' || $acquired->{state} ne 'queued';
    sleep 0.5;
}
my $execution = $acquired->{execution} || 'executed';
my $source_request = $acquired->{authoritative_request_id} || $request_id;
warn "Validation override $override selected; machine admission and durable audit remain enforced.\n" if $override ne 'none';
if ($execution eq 'reused' || $execution eq 'joined' || $execution eq 'skipped') {
    warn "Validation $request_id $execution authoritative request $source_request ($acquired->{state}).\n";
    exit 0 if $acquired->{state} eq 'completed' || $execution eq 'skipped';
    exit 130 if $acquired->{state} eq 'cancelled';
    exit 1;
}
die "validation request became $acquired->{state} before execution\n" unless $acquired->{state} eq 'active';
$ENV{AZEDARACH_VALIDATION_REQUEST_ID} = $request_id;
$ENV{AZEDARACH_VALIDATION_CLASS} = $class;
$ENV{AZEDARACH_VALIDATION_PROFILE} = $profile;
$ENV{AZEDARACH_VALIDATION_SOURCE_REVISION} = $revision;
$ENV{AZEDARACH_VALIDATION_SCOPE} = $scope;
$ENV{AZEDARACH_VALIDATION_PURPOSE} = $purpose;
$ENV{AZEDARACH_VALIDATION_EXECUTION} = 'executed';
$ENV{AZEDARACH_VALIDATION_AUTHORITATIVE_REQUEST_ID} = $request_id;
$ENV{AZEDARACH_VALIDATION_OVERRIDE} = $override;
my ($evidence_fh, $evidence_file) = tempfile('azedarach-validation-evidence-XXXXXX', TMPDIR => 1, UNLINK => 0);
close $evidence_fh;
$ENV{AZEDARACH_VALIDATION_EVIDENCE_FILE} = $evidence_file;
my ($fatal_evidence_fh, $fatal_evidence_file) = tempfile('azedarach-validation-fatal-XXXXXX', TMPDIR => 1, UNLINK => 0);
close $fatal_evidence_fh;
$ENV{AZEDARACH_VALIDATION_FATAL_EVIDENCE_FILE} = $fatal_evidence_file;
my ($runtime_fh, $candidate_runtime) = tempfile('azedarach-validation-runtime-XXXXXX', TMPDIR => 1, UNLINK => 1);
close $runtime_fh;
unlink $candidate_runtime or die "remove validation runtime placeholder: $!\n";
mkdir $candidate_runtime, 0700 or die "create private validation runtime: $!\n";
$ENV{AZEDARACH_VALIDATION_CANDIDATE_RUNTIME} = $candidate_runtime;

my $wrapper_pid = $$;
my $heartbeat = fork();
die "fork validation heartbeat: $!\n" unless defined $heartbeat;
if ($heartbeat == 0) {
    my $heartbeat_interval = $ENV{AZEDARACH_VALIDATION_HEARTBEAT_INTERVAL_SECONDS} || 10;
    my $next = time() + $heartbeat_interval;
    while (getppid() == $wrapper_pid) {
        sleep 0.25;
        next if time() < $next;
        my $renewal = fork();
        exit 1 unless defined $renewal;
        if ($renewal == 0) {
            clear_candidate_routing_environment();
            $ENV{AZEDARACH_OTEL} = 'off';
            exec $control_az, 'validation', 'heartbeat', '--request', $request_id, '--ttl', '30'
                or exit 127;
        }
        my $renewal_status;
        while (1) {
            my $waited = waitpid($renewal, WNOHANG);
            if ($waited == $renewal) {
                $renewal_status = $?;
                last;
            }
            if (getppid() != $wrapper_pid) {
                kill 'TERM', $renewal;
                waitpid($renewal, 0);
                exit 0;
            }
            sleep 0.1;
        }
        if (wait_status_code($renewal_status) != 0) {
            kill 'TERM', $wrapper_pid if getppid() == $wrapper_pid;
            exit 1;
        }
        exit 0 if getppid() != $wrapper_pid;
        $next = time() + $heartbeat_interval;
    }
    exit 0;
}

# Controlled timing capacity waits for already-running unleased Go work to
# quiesce. Publication gates intentionally start immediately.
if ($purpose eq 'capacity' && $class eq 'aggregate') {
    my $clear_samples = 0;
    while ($clear_samples < 4) {
        my $external = external_go_processes($wrapper_pid);
        $clear_samples = $external == 0 ? $clear_samples + 1 : 0;
        sleep 0.5 if $clear_samples < 4;
    }
}

socketpair(my $broker_parent, my $broker_child, AF_UNIX, SOCK_STREAM, PF_UNSPEC)
    or die "create nested validation authorization capability: $!\n";
$broker_parent->autoflush(1);
$broker_child->autoflush(1);
my $child_flags = fcntl($broker_child, F_GETFD, 0);
die "read nested validation descriptor flags: $!\n" unless defined $child_flags;
fcntl($broker_child, F_SETFD, $child_flags & ~FD_CLOEXEC)
    or die "preserve nested validation descriptor across exec: $!\n";

my $supervisor = fork();
die "fork validation command supervisor: $!\n" unless defined $supervisor;
if ($supervisor == 0) {
    close $broker_parent;
    my $parent = $wrapper_pid;
    my $payload = fork();
    die "fork validation command: $!\n" unless defined $payload;
    if ($payload == 0) {
        setpgid(0, 0);
        delete $ENV{AZEDARACH_VALIDATION_LEASE_TOKEN};
        # Control and cleanup client routing belongs to the wrapper supervisors,
        # never to the payload. Route candidate runtime assets through the
        # wrapper-owned private directory and expose the same path as the
        # mandatory cleanup handle.
        delete @ENV{qw(
            AZEDARACH_DAEMON_BIN
            AZEDARACH_DAEMON_SCOPE
            AZEDARACH_DAEMON_SCOPE_SOURCE
            AZEDARACH_VALIDATION_CONTROL_AZ_BIN
            AZEDARACH_VALIDATION_AZ_BIN
            AZEDARACH_VALIDATION_CLEANUP_AZ_BIN
            AZEDARACH_VALIDATION_TEST_CLEANUP_WATCHDOG_FILE
        )};
        $ENV{XDG_RUNTIME_DIR} = $ENV{AZEDARACH_VALIDATION_CANDIDATE_RUNTIME};
        $ENV{AZEDARACH_VALIDATION_CLEANUP_HANDLE} = $ENV{AZEDARACH_VALIDATION_CANDIDATE_RUNTIME};
        $ENV{AZEDARACH_VALIDATION_NESTED_FD} = fileno($broker_child);
        exec @ARGV or die "exec validation command $ARGV[0]: $!\n";
    }
    close $broker_child;
    eval { setpgid($payload, $payload) };
    my $forward = sub { my ($signal) = @_; kill $signal, -$payload if $payload; };
    local $SIG{TERM} = sub { $forward->('TERM') };
    local $SIG{INT} = sub { $forward->('INT') };
    local $SIG{HUP} = sub { $forward->('HUP') };
    while (1) {
        my $waited = waitpid($payload, WNOHANG);
        exit wait_status_code($?) if $waited == $payload;
        if (getppid() != $parent) {
            kill 'TERM', -$payload;
            for (1..20) {
                $waited = waitpid($payload, WNOHANG);
                exit wait_status_code($?) if $waited == $payload;
                sleep 0.1;
            }
            kill 'KILL', -$payload;
            waitpid($payload, 0);
            exit 137;
        }
        sleep 0.1;
    }
}
close $broker_child;

my $interrupted = 0;
my $forward = sub { my ($signal) = @_; $interrupted = 1; kill $signal, $supervisor if $supervisor; };
local $SIG{TERM} = sub { $forward->('TERM') };
local $SIG{INT} = sub { $forward->('INT') };
local $SIG{HUP} = sub { $forward->('HUP') };
my $selector = IO::Select->new($broker_parent);
my $broker_buffer = '';
my $max_external_go = 0;
my $overlap_detected = 0;
my $next_sample = 0;
my $status = 0;
while (1) {
    for my $ready ($selector->can_read(0.1)) {
        my $bytes = sysread($ready, my $chunk, 8192);
        if (!defined($bytes) || $bytes == 0) {
            $selector->remove($ready);
            next;
        }
        $broker_buffer .= $chunk;
        while ($broker_buffer =~ s/^(.*?\n)//) {
            authorize_nested($broker_parent, $1, $control_az, $request_id, $lease_token);
        }
    }
    if ($purpose eq 'capacity' && $class eq 'aggregate' && time() >= $next_sample) {
        my $external = external_go_processes($wrapper_pid);
        $max_external_go = $external if $external > $max_external_go;
        $overlap_detected ||= $external > 0;
        $next_sample = time() + 0.5;
    }
    my $waited = waitpid($supervisor, WNOHANG);
    if ($waited == $supervisor) {
        $supervisor = 0;
        $status = $?;
        last;
    }
}
close $broker_parent;
my $exit_code = wait_status_code($status);
my $payload_exit_code = $exit_code;
my $cleanup_error = '';
if (!$stop_scoped_daemon->()) {
    $cleanup_error = 'worktree-scoped daemon stop failed';
}
my $cleanup_errors;
my $runtime_cleanup_exception = '';
eval { remove_tree($candidate_runtime, {error => \$cleanup_errors}); 1 }
    or $runtime_cleanup_exception = $@ || 'candidate runtime cleanup failed';
my $runtime_cleanup_error = join('; ', map { %$_ } @$cleanup_errors) if $cleanup_errors && @$cleanup_errors;
$cleanup_error = join('; ', grep { $_ ne '' } ($cleanup_error, $runtime_cleanup_exception, $runtime_cleanup_error || ''));
if ($cleanup_error ne '') {
    warn "candidate validation cleanup failed: $cleanup_error\n";
    $exit_code = 78;
}
if ($class eq 'aggregate') {
    my $finished_revision = eval { my $value = capture($git, 'rev-parse', 'HEAD'); $value =~ s/\s+\z//; $value };
    if (!$finished_revision || $finished_revision ne $revision) {
        warn "aggregate validation source revision changed while the lease was held\n";
        $exit_code = 76 if $exit_code == 0;
    }
}
my $production_epoch_at_finish = read_optional_file($production_epoch_file);
my $production_install_overlapped = $production_epoch_at_finish ne $production_epoch_at_start;
if ($production_install_overlapped && $exit_code == 0) {
    warn "validation overlapped a production install and is noncanonical\n";
    $exit_code = 74;
}

merge_whole_gate_evidence($evidence_file, {
    held => JSON::PP::true, request_id => $request_id, class => $class,
    scope => $scope, purpose => $purpose, execution => 'executed',
    authoritative_request_id => $request_id, override => $override,
    profile => $profile, source_revision => $revision, present => JSON::PP::true,
    overlap_detected => $overlap_detected ? JSON::PP::true : JSON::PP::false,
    external_go_processes => $max_external_go,
    cleanup_succeeded => $cleanup_error eq '' ? JSON::PP::true : JSON::PP::false,
    cleanup_error => $cleanup_error,
    payload_exit_code => $payload_exit_code,
    production_install_overlapped => $production_install_overlapped ? JSON::PP::true : JSON::PP::false,
});
if ($purpose eq 'capacity' && $class eq 'aggregate' && $overlap_detected && $exit_code == 0) {
    warn "aggregate validation overlapped $max_external_go unleased Go process(es)\n";
    $exit_code = 75;
}
my $terminal = $interrupted ? 'cancelled' : ($exit_code == 0 ? 'completed' : 'failed');
kill 'TERM', $heartbeat;
waitpid($heartbeat, 0);
my $outcome = "exit $exit_code";
my $fatal_evidence = read_json_file($evidence_file);
if (($fatal_evidence->{fatal_phase} || '') ne '') {
    my $payload_phase = bounded_outcome_detail($fatal_evidence->{fatal_phase});
    my $payload_detail = bounded_outcome_detail($fatal_evidence->{fatal_detail} || 'validation payload configuration failed');
    if ($cleanup_error ne '') {
        my $cleanup_detail = bounded_outcome_detail($cleanup_error);
        $outcome .= " phase=cleanup payload_exit=$payload_exit_code detail=$cleanup_detail payload_phase=$payload_phase payload_detail=$payload_detail";
    } else {
        $outcome .= " phase=$payload_phase detail=$payload_detail";
    }
} elsif ($cleanup_error ne '') {
    my $detail = bounded_outcome_detail($cleanup_error);
    $outcome .= " phase=cleanup payload_exit=$payload_exit_code detail=$detail";
}
my @finish = ($control_az, 'validation', 'finish', '--request', $request_id, '--state', $terminal, '--outcome', $outcome);
if (-s $evidence_file) {
    open my $final_evidence, '<', $evidence_file or die "open validation evidence: $!\n";
    local $/;
    push @finish, '--evidence-json', (<$final_evidence> // '');
    close $final_evidence;
}
my $finish_failed = !eval { control_capture(@finish); 1 };
warn "validation finish failed for $request_id\n" if $finish_failed;
unlink $evidence_file if -e $evidence_file;
unlink $fatal_evidence_file if -e $fatal_evidence_file;
my $final_exit = ($finish_failed && $exit_code == 0) ? 70 : $exit_code;
exit($final_exit);

sub read_optional_file {
    my ($path) = @_;
    return '' unless -f $path;
    open my $fh, '<', $path or return '';
    local $/;
    my $value = <$fh> // '';
    close $fh;
    $value =~ s/\s+\z//;
    return $value;
}

sub read_json_file {
    my ($path) = @_;
    return {} unless -s $path;
    open my $fh, '<', $path or return {};
    local $/;
    my $decoded = eval { decode_json(<$fh> // '{}') };
    close $fh;
    return $decoded && ref($decoded) eq 'HASH' ? $decoded : {};
}

sub bounded_outcome_detail {
    my ($detail) = @_;
    $detail = '' unless defined $detail;
    $detail =~ s/\s+/ /g;
    $detail =~ s/^\s+|\s+$//g;
    return substr($detail, 0, 512);
}

sub bounded_cleanup_system {
    my ($program, $timeout, $watchdog, @arguments) = @_;
    my $child = fork();
    return -1 unless defined $child;
    if ($child == 0) {
        setpgid(0, 0);
        exec $program, @arguments or exit 127;
    }
    eval { setpgid($child, $child) };
    my $deadline = time() + $timeout;
    while (1) {
        my $waited = waitpid($child, WNOHANG);
        return $? if $waited == $child;
        my $expired = time() >= $deadline
            || ($watchdog ne '' && read_optional_file($watchdog) eq 'expire');
        last if $expired;
        sleep 0.05;
    }
    kill 'TERM', -$child;
    my $kill_deadline = time() + 2;
    my $leader_reaped = 0;
    while (1) {
        if (!$leader_reaped) {
            my $waited = waitpid($child, WNOHANG);
            $leader_reaped = 1 if $waited == $child;
        }
        last unless kill 0, -$child;
        my $kill_now = time() >= $kill_deadline
            || ($watchdog ne '' && read_optional_file($watchdog) eq 'kill');
        last if $kill_now;
        sleep 0.05;
    }
    kill 'KILL', -$child;
    waitpid($child, 0) unless $leader_reaped;
    return -2;
}

sub authorize_nested {
    my ($broker, $line, $az_path, $held_request, $token) = @_;
    my $request = eval { decode_json($line) };
    my $nonce = $request && $request->{nonce} ? $request->{nonce} : '';
    my $response = {ok => JSON::PP::false, nonce => $nonce, error => 'invalid nested validation authorization request'};
    if ($request && ($request->{request_id} || '') eq $held_request) {
        local $ENV{AZEDARACH_VALIDATION_LEASE_TOKEN} = $token;
        my $ok = eval { control_capture($az_path, 'validation', 'authorize-nested', '--request', $held_request, '--class', ($request->{class} || ''), '--scope', ($request->{scope} || ''), '--purpose', ($request->{purpose} || '')); 1 };
        if ($ok) {
            $response = {ok => JSON::PP::true, nonce => $nonce, class => $ENV{AZEDARACH_VALIDATION_CLASS}, scope => $ENV{AZEDARACH_VALIDATION_SCOPE}, purpose => $ENV{AZEDARACH_VALIDATION_PURPOSE}, profile => $ENV{AZEDARACH_VALIDATION_PROFILE}, source_revision => $ENV{AZEDARACH_VALIDATION_SOURCE_REVISION}};
        } else {
            $response->{error} = 'daemon rejected nested validation authorization';
        }
    }
    print {$broker} encode_json($response) . "\n";
}

sub external_go_processes {
    my ($root_pid) = @_;
    my $ps_bin = $ENV{AZEDARACH_VALIDATION_PS_BIN} || 'ps';
    open my $ps, '-|', $ps_bin, '-axo', 'pid=,ppid=,stat=,comm=' or die "inspect validation process load: $!\n";
    my (%parent, %command);
    while (my $line = <$ps>) {
        next unless $line =~ /^\s*(\d+)\s+(\d+)\s+(\S+)\s+(.+?)\s*$/;
        next if $3 =~ /^Z/;
        $parent{$1} = $2;
        $command{$1} = $4;
    }
    close $ps;
    my %inside = ($root_pid => 1);
    my $changed = 1;
    while ($changed) {
        $changed = 0;
        for my $pid (keys %parent) {
            next if $inside{$pid};
            if ($inside{$parent{$pid}}) { $inside{$pid} = 1; $changed = 1; }
        }
    }
    my %ancestor;
    my $cursor = $parent{$root_pid};
    while ($cursor && !$ancestor{$cursor}++) { $cursor = $parent{$cursor}; }
    my $count = 0;
    for my $pid (keys %command) {
        next if $inside{$pid} || $ancestor{$pid};
        my $name = basename($command{$pid});
        $count++ if $name eq 'go' || $name eq 'compile' || $name eq 'link' || $name eq 'vet' || $name =~ /\.test$/;
    }
    return $count;
}

sub merge_whole_gate_evidence {
    my ($path, $whole) = @_;
    my $existing = {};
    my $fatal = read_json_file($ENV{AZEDARACH_VALIDATION_FATAL_EVIDENCE_FILE} || $path . '.fatal');
    if (-s $path) {
        open my $in, '<', $path or die "open accumulated validation evidence: $!\n";
        local $/;
        $existing = decode_json(<$in> // '{}');
        close $in;
        for my $field (qw(held request_id class scope purpose execution authoritative_request_id override profile source_revision)) {
            die "accumulated validation lease evidence identity changed\n" if defined($existing->{$field}) && "$existing->{$field}" ne "$whole->{$field}";
        }
    }
    $whole->{overlap_detected} = ($whole->{overlap_detected} || $existing->{overlap_detected}) ? JSON::PP::true : JSON::PP::false;
    $whole->{external_go_processes} = ($existing->{external_go_processes} || 0) > $whole->{external_go_processes} ? $existing->{external_go_processes} : $whole->{external_go_processes};
    $whole->{report_path} = $existing->{report_path} if $existing->{report_path};
    $whole->{report_paths} = $existing->{report_paths} if $existing->{report_paths};
    $whole->{failure_summary} = $existing->{failure_summary} if $existing->{failure_summary};
    $whole->{fatal_phase} = $existing->{fatal_phase} if $existing->{fatal_phase};
    $whole->{fatal_detail} = $existing->{fatal_detail} if $existing->{fatal_detail};
    $whole->{fatal_phase} = $fatal->{fatal_phase} if $fatal->{fatal_phase};
    $whole->{fatal_detail} = $fatal->{fatal_detail} if $fatal->{fatal_detail};
    open my $out, '>', $path or die "write whole-gate validation evidence: $!\n";
    print {$out} encode_json($whole) . "\n";
    close $out;
}

sub capture {
    my (@command) = @_;
    open my $fh, '-|', @command or die "start validation command: $!\n";
    local $/;
    my $output = <$fh> // '';
    close $fh;
    die "validation command failed\n" if $? != 0;
    return $output;
}

sub control_capture {
    my (@command) = @_;
    local %ENV = %ENV;
    clear_candidate_routing_environment();
    # Acquire/heartbeat polling is control-plane plumbing. Reinitializing an
    # exporter for every short-lived poll adds no useful span relationship and
    # floods queued command output with repeated startup lines.
    $ENV{AZEDARACH_OTEL} = 'off';
    return capture(@command);
}

sub clear_candidate_routing_environment {
    delete @ENV{qw(
        AZEDARACH_DAEMON_BIN
        AZEDARACH_DAEMON_SCOPE
        AZEDARACH_DAEMON_SCOPE_SOURCE
        AZEDARACH_VALIDATION_CLEANUP_AZ_BIN
        AZEDARACH_VALIDATION_CANDIDATE_RUNTIME
        AZEDARACH_VALIDATION_CLEANUP_HANDLE
    )};
}

sub clear_control_authority_environment {
    delete @ENV{qw(
        AZEDARACH_VALIDATION_CONTROL_AZ_BIN
        AZEDARACH_VALIDATION_AZ_BIN
        AZEDARACH_VALIDATION_LEASE_TOKEN
        AZEDARACH_VALIDATION_REQUEST_ID
        AZEDARACH_VALIDATION_NESTED_FD
        AZEDARACH_VALIDATION_EVIDENCE_FILE
        AZEDARACH_VALIDATION_FATAL_EVIDENCE_FILE
        AZEDARACH_VALIDATION_CLASS
        AZEDARACH_VALIDATION_PROFILE
        AZEDARACH_VALIDATION_SOURCE_REVISION
        AZEDARACH_VALIDATION_SCOPE
        AZEDARACH_VALIDATION_PURPOSE
        AZEDARACH_VALIDATION_EXECUTION
        AZEDARACH_VALIDATION_AUTHORITATIVE_REQUEST_ID
        AZEDARACH_VALIDATION_OVERRIDE
    )};
}

sub wait_status_code {
    my ($status) = @_;
    return ($status & 127) ? 128 + ($status & 127) : ($status >> 8);
}

sub random_token {
    open my $random, '<:raw', '/dev/urandom' or die "open random source: $!\n";
    my $bytes = '';
    my $read = read($random, $bytes, 32);
    close $random;
    die "read random source\n" unless defined($read) && $read == 32;
    return unpack('H*', $bytes);
}

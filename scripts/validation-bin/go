#!/usr/bin/env bash
set -euo pipefail

real_go="${AZEDARACH_REAL_GO_BIN:-}"
if [[ -z "$real_go" ]]; then
  while IFS= read -r candidate; do
    if [[ -x "$candidate" && ! "$candidate" -ef "$0" ]]; then
      real_go="$candidate"
      export AZEDARACH_REAL_GO_BIN="$real_go"
      break
    fi
  done < <(
    IFS=:
    for directory in $PATH; do
      [[ -n "$directory" ]] || directory=.
      printf '%s/go\n' "$directory"
    done
  )
fi
if [[ -z "$real_go" || ! -x "$real_go" || "$real_go" -ef "$0" ]]; then
  if [[ -n "${AZEDARACH_VALIDATION_EVIDENCE_FILE:-}" && ! -s "$AZEDARACH_VALIDATION_EVIDENCE_FILE" ]]; then
    printf '%s\n' '{"fatal_phase":"toolchain_configuration","fatal_detail":"AZEDARACH_REAL_GO_BIN must name the executable Go toolchain"}' >"$AZEDARACH_VALIDATION_EVIDENCE_FILE"
  fi
  echo "AZEDARACH_REAL_GO_BIN must name the executable Go toolchain" >&2
  exit 78
fi

# Development Go commands rely on per-worktree cache isolation and never enter
# daemon validation admission. Publication wrappers still provide their nested
# capability to the command tree, but Go itself needs no additional hop.
exec "$real_go" "$@"

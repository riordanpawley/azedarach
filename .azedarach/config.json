{
  "$schema": "https://raw.githubusercontent.com/riordanpawley/azedarach/main/docs/config.schema.json",
  "$version": 10,
  "cliTool": "codex",
  "devServer": {
    "basePort": 3000,
    "environments": {},
    "maxPort": 3100
  },
  "diagnostics": {
    "latencyTrace": true
  },
  "git": {
    "baseBranch": "main",
    "defaultMergeStrategy": "merge",
    "fetchEnabled": true,
    "pushEnabled": true,
    "showLineChanges": true,
    "workflowMode": "local"
  },
  "githooks": {
    "bestEffort": true,
    "boundaryCheck": {
      "command": "",
      "enabled": false
    },
    "commands": {},
    "restage": {
      "enabled": false,
      "paths": []
    },
    "specSync": {
      "autoStageDocs": true,
      "command": "",
      "enabled": false
    }
  },
  "issueResources": {
    "cleanupCommands": [],
    "env": {},
    "failedStartCleanupCommands": [],
    "prepareCommands": [],
    "reconcileCommand": ""
  },
  "issueTracker": {
    "backend": "local",
    "linear": {
      "command": "linear-cli",
      "conflictPolicy": "last_write_wins",
      "filter": {
        "assignee": "me"
      },
      "project": "",
      "team": "",
      "webhooks": {
        "enabled": false,
        "events": [],
        "port": 0,
        "secret": "",
        "transport": "sdk",
        "url": ""
      }
    },
    "sync": {
      "enabled": false
    }
  },
  "issues": {
    "autoArchive": {
      "closedAfterDays": 30,
      "enabled": true,
      "interval": "24h"
    },
    "path": ".azedarach",
    "syncInterval": 300
  },
  "keyboard": {
    "jumpLabelChars": "cieahtsn"
  },
  "merge": {
    "autoMerge": false,
    "compareWithOrigin": true,
    "strategy": "merge"
  },
  "network": {
    "autoDetect": true,
    "checkInterval": 60,
    "offlineTimeout": 300,
    "retryAttempts": 3
  },
  "notifications": {
    "completedTask": true,
    "errorThreshold": 3,
    "failedTask": true
  },
  "orchestration": {
    "via": "az"
  },
  "pr": {
    "autoLink": true,
    "createWithoutMerge": false,
    "draftByDefault": true,
    "notifyAfterCreate": true
  },
  "scheduledScripts": {
    "env": {},
    "scripts": []
  },
  "session": {
    "asyncInitCommands": [],
    "dangerouslySkipPermissions": true,
    "logDir": "/Users/riordan/.azedarach/logs",
    "shell": "zsh",
    "syncInitCommands": [],
    "timeoutMs": 30000
  },
  "spec": {
    "enabled": true
  },
  "worktree": {
    "asyncInitCommands": [],
    "autoCleanup": true,
    "basePath": "../",
    "keepDays": 7,
    "nameFormat": "{project}-{issueID}",
    "syncInitCommands": [
      "mkdir -p .gocache .gopath",
      "base_repo=$(dirname \"$(dirname \"$(dirname \"$(git rev-parse --git-dir)\")\")\") \u0026\u0026 cp -R \"$base_repo/.gocache\" \"$base_repo/.gopath\" . 2\u003e/dev/null || true",
      "direnv allow"
    ]
  }
}
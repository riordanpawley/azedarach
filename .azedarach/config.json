{
  "$schema": "./config.schema.json",
  "$version": 7,
  "cliTool": "codex",
  "devServer": {
    "basePort": 3000,
    "environments": {},
    "maxPort": 3100
  },
  "git": {
    "baseBranch": "main",
    "defaultMergeStrategy": "merge",
    "fetchEnabled": true,
    "pushEnabled": true,
    "showLineChanges": true,
    "workflowMode": "local"
  },
  "issues": {
    "path": ".azedarach",
    "syncInterval": 300
  },
  "keyboard": {
    "jumpLabelChars": "cieahtsn"
  },
  "merge": {
    "autoMerge": false,
    "compareWithOrigin": true,
    "strategy": "merge"
  },
  "network": {
    "autoDetect": true,
    "checkInterval": 60,
    "offlineTimeout": 300,
    "retryAttempts": 3
  },
  "notifications": {
    "completedTask": true,
    "errorThreshold": 3,
    "failedTask": true
  },
  "pr": {
    "autoLink": true,
    "createWithoutMerge": false,
    "draftByDefault": true,
    "notifyAfterCreate": true
  },
  "session": {
    "dangerouslySkipPermissions": false,
    "initCommands": [
      "direnv allow",
      "cd go-bubbletea"
    ],
    "logDir": "/Users/riordan/.azedarach/logs",
    "shell": "zsh",
    "timeoutMs": 30000
  },
  "spec": {
    "enabled": false
  },
  "worktree": {
    "autoCleanup": true,
    "basePath": "../",
    "initCommands": [
      "direnv allow",
      "cd go-bubbletea"
    ],
    "keepDays": 7,
    "nameFormat": "{project}-{issueID}"
  }
}
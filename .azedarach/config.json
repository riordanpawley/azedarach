{
  "$schema": "https://raw.githubusercontent.com/riordanpawley/azedarach/main/docs/config.schema.json",
  "$version": 11,
  "cliTool": "codex",
  "devServer": {
    "basePort": 3000,
    "environments": {},
    "maxPort": 3100
  },
  "diagnostics": {
    "latencyTrace": true
  },
  "gate": {
    "command": "just review-gate",
    "environmentFingerprint": "azedarach-go-review-v1",
    "failureArtifactPaths": [
      ".tmp/test-timing"
    ],
    "stages": [
      {
        "id": "build",
        "command": "just build",
        "resources": ["go-build-cache", "go-toolchain"]
      },
      {
        "id": "cold-semantic-suite",
        "command": "just test",
        "resources": ["go-test-cache", "go-toolchain"],
        "artifactPaths": [".tmp/test-timing"]
      },
      {
        "id": "artifact-install-contract",
        "command": "just test-build-contract",
        "resources": ["go-build-cache"]
      },
      {
        "id": "local-tracing-contract",
        "command": "just test-jaeger-contract",
        "resources": ["container-engine", "loopback-ports"]
      },
      {
        "id": "static-boundary-contract",
        "command": "just check-boundaries",
        "resources": ["go-build-cache", "go-toolchain"]
      }
    ]
  },
  "git": {
    "baseBranch": "main",
    "defaultMergeStrategy": "merge",
    "fetchEnabled": true,
    "pushEnabled": true,
    "showLineChanges": true,
    "workflowMode": "local"
  },
  "githooks": {
    "bestEffort": true,
    "boundaryCheck": {
      "command": "",
      "enabled": false
    },
    "commands": {},
    "restage": {
      "enabled": false,
      "paths": []
    },
    "specSync": {
      "autoStageDocs": true,
      "command": "",
      "enabled": false
    }
  },
  "issueResources": {
    "cleanupCommands": [],
    "env": {},
    "failedStartCleanupCommands": [],
    "prepareCommands": [],
    "reconcileCommand": ""
  },
  "issueTracker": {
    "backend": "local",
    "linear": {
      "command": "linear-cli",
      "conflictPolicy": "last_write_wins",
      "filter": {
        "assignee": "me"
      },
      "project": "",
      "team": "",
      "webhooks": {
        "enabled": false,
        "events": [],
        "port": 0,
        "secret": "",
        "transport": "sdk",
        "url": ""
      }
    },
    "sync": {
      "enabled": false
    }
  },
  "issues": {
    "autoArchive": {
      "closedAfterDays": 30,
      "enabled": true,
      "interval": "24h"
    },
    "path": ".azedarach",
    "syncInterval": 300
  },
  "keyboard": {
    "jumpLabelChars": "cieahtsn"
  },
  "merge": {
    "autoMerge": false,
    "compareWithOrigin": true,
    "strategy": "merge"
  },
  "network": {
    "autoDetect": true,
    "checkInterval": 60,
    "offlineTimeout": 300,
    "retryAttempts": 3
  },
  "notifications": {
    "completedTask": true,
    "errorThreshold": 3,
    "failedTask": true
  },
  "orchestration": {
    "via": "az"
  },
  "pr": {
    "autoLink": true,
    "createWithoutMerge": false,
    "draftByDefault": true,
    "notifyAfterCreate": true
  },
  "publicationEvidence": {
    "activePathProfiles": [
      "merge-gate",
      "cold"
    ],
    "dependencies": {
      "daemon-operations-store": [
        "internal/daemon/operations/store"
      ],
      "protocol-contract": [
        "internal/contracts/protocol"
      ]
    },
    "exactBaseSurfaces": {
      "authority_boundary": [
        "internal/client",
        "internal/daemon",
        "internal/tui"
      ],
      "generated_artifact": [
        "internal/contracts/protocol/testdata",
        "internal/ipc/codec/testdata"
      ],
      "migration": [
        "internal/daemon/operations/store/migrations",
        "internal/services/issues/migrations"
      ],
      "protocol": [
        "internal/contracts/protocol"
      ],
      "schema": [
        "docs/config.schema.json"
      ],
      "shared_invariant": [
        "internal/daemon/invariant_policy.go"
      ]
    },
    "policyVersion": "azedarach-publication-evidence-v1"
  },
  "scheduledScripts": {
    "env": {},
    "scripts": []
  },
  "session": {
    "asyncInitCommands": [],
    "codexAppServer": false,
    "dangerouslySkipPermissions": true,
    "logDir": "/Users/riordan/.azedarach/logs",
    "shell": "zsh",
    "syncInitCommands": [],
    "timeoutMs": 30000
  },
  "spec": {
    "enabled": true
  },
  "worktree": {
    "asyncInitCommands": [],
    "autoCleanup": true,
    "basePath": "../",
    "keepDays": 7,
    "nameFormat": "{project}-{issueID}",
    "syncInitCommands": [
      "direnv allow"
    ]
  }
}

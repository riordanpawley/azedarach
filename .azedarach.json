{
  "$schema": 6,
  "cliTool": "codex",
  "issueTracker": {
    "local": {
      "syncEnabled": false
    }
  },
  "worktree": {
    "initCommands": [
      "direnv allow",
      "cd ts-opentui && bun install"
    ],
    "continueOnFailure": true,
    "parallel": false,
    "copyPaths": [
      ".direnv",
      "./ts-opentui/node_modules",
      ".env.local"
    ]
  },
  "git": {
    "pushBranchOnCreate": true,
    "remote": "origin",
    "branchPrefix": "az-",
    "baseBranch": "main",
    "workflowMode": "local"
  },
  "session": {
    "shell": "zsh",
    "tmuxPrefix": "C-a"
  },
  "stateDetection": {
    "patternMatching": true
  },
  "pr": {
    "enabled": false
  },
  "merge": {
    "validateCommands": [
      "cd ts-opentui && bun run type-check"
    ],
    "fixCommand": "cd ts-opentui && bun run fix",
    "maxFixAttempts": 2,
    "startAiSessionOnFailure": true
  },
  "keyboard": {
    "jumpLabelChars": "cieahtsn"
  }
}

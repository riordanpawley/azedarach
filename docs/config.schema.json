{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/riordanpawley/azedarach/main/docs/config.schema.json",
  "title": "Azedarach Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$version": {
      "type": "integer",
      "const": 9
    },
    "cliTool": {
      "type": "string",
      "enum": ["claude", "opencode", "codex"],
      "default": "claude"
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseBranch": {
          "type": "string",
          "default": "main"
        },
        "workflowMode": {
          "type": "string",
          "enum": ["worktree", "local", "branch", "origin"],
          "default": "worktree"
        },
        "showLineChanges": {
          "type": "boolean",
          "default": true
        },
        "defaultMergeStrategy": {
          "type": "string",
          "default": "merge"
        },
        "pushEnabled": {
          "type": "boolean",
          "default": true
        },
        "fetchEnabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "githooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "object",
          "description": "Shell commands keyed by git hook name (for example pre-commit, post-commit).",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {}
        },
        "bestEffort": {
          "type": "boolean",
          "description": "Run hook pipeline in best-effort mode (errors are logged but do not fail the hook process).",
          "default": true
        },
        "restage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          }
        },
        "specSync": {
          "type": "object",
          "description": "Deprecated compatibility field; prefer githooks.commands.pre-commit.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "command": {
              "type": "string",
              "default": ""
            },
            "autoStageDocs": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "boundaryCheck": {
          "type": "object",
          "description": "Deprecated compatibility field; prefer githooks.commands.pre-commit.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "command": {
              "type": "string",
              "default": "just check-boundaries"
            }
          }
        }
      }
    },
    "keyboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jumpLabelChars": {
          "type": "string",
          "default": "abcdefghijklmnopqrstuvwxyz"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dangerouslySkipPermissions": {
          "type": "boolean",
          "default": false
        },
        "shell": {
          "type": "string",
          "default": "zsh"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "default": 30000
        },
        "logDir": {
          "type": "string"
        },
        "initCommands": {
          "type": "array",
          "description": "Commands run before the launched AI tool. These commands block session startup and failures prevent the tool launch.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "sideEffectCommands": {
          "type": "array",
          "description": "Commands started in a detached tmux side-effects window during session startup without blocking the AI tool launch. Output is visible in that window and written under .azedarach/session-side-effects/<issue>/<session>/ in the session worktree.",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draftByDefault": {
          "type": "boolean",
          "default": true
        },
        "autoLink": {
          "type": "boolean",
          "default": true
        },
        "notifyAfterCreate": {
          "type": "boolean",
          "default": true
        },
        "createWithoutMerge": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "default": "merge"
        },
        "autoMerge": {
          "type": "boolean",
          "default": false
        },
        "compareWithOrigin": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completedTask": {
          "type": "boolean",
          "default": true
        },
        "failedTask": {
          "type": "boolean",
          "default": true
        },
        "errorThreshold": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        }
      }
    },
    "issues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "default": ".azedarach"
        },
        "syncInterval": {
          "type": "integer",
          "minimum": 1,
          "default": 300
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoDetect": {
          "type": "boolean",
          "default": true
        },
        "checkInterval": {
          "type": "integer",
          "minimum": 1,
          "default": 60
        },
        "offlineTimeout": {
          "type": "integer",
          "minimum": 1,
          "default": 300
        },
        "retryAttempts": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        }
      }
    },
    "devServer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 3000
        },
        "maxPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 3100
        },
        "environments": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basePath": {
          "type": "string",
          "default": "../"
        },
        "nameFormat": {
          "type": "string",
          "default": "{project}-{issueID}"
        },
        "autoCleanup": {
          "type": "boolean",
          "default": true
        },
        "keepDays": {
          "type": "integer",
          "minimum": 1,
          "default": 7
        },
        "syncInitCommands": {
          "type": "array",
          "description": "Blocking worktree readiness commands. These run for each newly created worktree, including missing ancestors, before descendant worktrees are created. Older worktree.initCommands entries are migrated here.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "asyncInitCommands": {
          "type": "array",
          "description": "Non-blocking worktree warmup commands. These start after blocking init succeeds and do not delay descendant worktree creation or session startup.",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "issueResources": {
      "type": "object",
      "description": "Opt-in issue-scoped local resource lifecycle hooks. Commands run with stable AZEDARACH_* context variables and configured env values.",
      "additionalProperties": false,
      "properties": {
        "env": {
          "type": "object",
          "description": "Environment variables exported for resource hooks and the launched session. Values may reference AZEDARACH_* context variables.",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "prepareCommands": {
          "type": "array",
          "description": "Commands run after worktree preparation and before tmux/AI launch. Failure stops session startup.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "failedStartCleanupCommands": {
          "type": "array",
          "description": "Commands run when resource preparation succeeded partially or later session startup fails.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "cleanupCommands": {
          "type": "array",
          "description": "Commands run on explicit session/issue lifecycle cleanup. No cleanup is inferred when this is empty.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "reconcileCommand": {
          "type": "string",
          "description": "Optional idempotent command that converges issue-scoped resources to AZEDARACH_RESOURCE_DESIRED_STATE=present or absent using stable AZEDARACH_* context.",
          "default": ""
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "via": {
          "type": "string",
          "enum": ["az", "native"],
          "default": "az"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latencyTrace": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}

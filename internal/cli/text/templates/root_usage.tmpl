Usage: az [command] [arguments]

Commands:
  (no command)         Start the Azedarach TUI
  session <subcommand>  Session commands (start|attach|stop|status)
  branch <subcommand>   Branch commands (merge)
  worktree <subcommand> Worktree commands (create)
  start <issue-id>      Alias for 'az session start <issue-id>'
  attach <issue-id>     Alias for 'az session attach <issue-id>'
  stop <issue-id>       Alias for 'az session stop <issue-id>'
  status [issue-id]     Alias for 'az session status [issue-id]'
  githooks <install|update|run|notify|hook>      Manage repo git hooks and run configured hook tasks
  gate <issue-id>            Run quality gates for an issue
  dev gate <issue-id>        Dev-family gate alias
  dev start <issue-id>       Start a dev server for an issue
  dev stop <issue-id>        Stop a dev server for an issue
  dev restart <issue-id>     Restart a dev server for an issue
  dev status <issue-id>      Show dev server status for an issue
  dev list                   List running dev servers across issues
  project <subcommand>       Project registry management (list|add|remove)
  impl list                          List implementations currently assigned to issues
  impl delete --confirm <implementation>  Remove an implementation assignment from all issues
  impl migrate <from> <to>           Migrate implementation assignments from one value to another
  operation <subcommand>     Inspect/cancel background operations (get|list|logs|cancel)
  log [sources]              Tail/stream daemon, TUI, and CLI log files
  ai install [--target=auto|rulesync|claude|codex|opencode,...] [--issue <id>] [--generate=auto|never]  Unified hook install across AI agent harnesses
  ai status [--target=auto|rulesync|claude|codex|opencode,...] [--project-dir <dir>] [--json]  Check Azedarach-managed AI hook installation
  ai uninstall [--target=auto|rulesync|claude|codex|opencode,...] [--project-dir <dir>] [--verbose]  Remove az-managed hook entries from AI agent harnesses
  ai migrate [--project-dir <dir>] [--verbose]  Strip legacy az notify/hook commands from existing hook configs
  ai hook run --agent=<claude|codex> [--json] <event>  Run an agent hook through the shared internal port
  tmux <selector|install-selector|uninstall-selector>  Manage tmux selector integration
  spec <subcommand>          Spec workflows (req|link|read|pack|lint|parity)
  decision <subcommand>      Decision records with rationale (list|get|record|update|delete|revisit|sync|import|link)
  issue list [--project <project-id>] [--json] [--deps] [--query <text>|-q <text>] [--created-after YYYY-MM-DD] [--created-before YYYY-MM-DD] [--updated-after YYYY-MM-DD] [--updated-before YYYY-MM-DD] [--status <status> ...] [--statuses a,b,c] [--limit N] [--id <id> ...] [--ids a,b,c] [--parent <id> ...] [--parents a,b,c] [--depends-on <id> ...] [--depends-on-ids a,b,c]  List issues from daemon-backed store
  issue search [--project <project-id>] [--json] [--deps] [--created-after YYYY-MM-DD] [--created-before YYYY-MM-DD] [--updated-after YYYY-MM-DD] [--updated-before YYYY-MM-DD] [--status <status> ...] [--statuses a,b,c] [--limit N] [--id <id> ...] [--ids a,b,c] [--parent <id> ...] [--parents a,b,c] [--depends-on <id> ...] [--depends-on-ids a,b,c] (--query <text>|-q <text>|<query>)  Search title, description, notes, design, acceptance, labels, and implementations
  issue get [--project <project-id>] [--id <id>] [--json] [--with-notes] [<id>]  Show a single issue from daemon-backed store
  issue get-many [--project <project-id>] --id <id> [--id <id> ...] [--ids a,b,c] [--json] [--with-notes]  Fetch many issues in requested order
  issue check [--project <project-id>] [--id <id>] [--json] [<id>]  Alias for issue get
  issue doctor [--project <project-id>] [--id <id>] [--json] [<id>]  Run integrity checks for one issue
  issue create [--project <project-id>] [--impl <implementation> ...] [--deferred] [--type ...] [--priority ...] [--title ...] [--description ...] [--json] [<title>]  Create an issue (auto-parent when AZEDARACH_ISSUE_ID is set; --impl is not parentage)
  issue split [--project <project-id>] [--parent <id>] [--impl <implementation> ...] [--type ...] [--priority ...] [--description ...] [--json] <title>  Create an isolated child issue/session for later parent-side merge
  issue update [--project <project-id>] [--id <id>] [--json] [<id>] [--title ...] [--description ...] [--notes ...] [--append-notes ...] [--status ...] [--force-worktree] [--type ...] [--priority ...] [--update-impl <impl> ...]  Update issue fields (`--status closed` integrates, cleans, then closes)
  issue close [--project <project-id>] [--id <id>|-i <id>] [--json] [--force-worktree] [<id>]  Integrate, clean up, and close an issue
  issue delete [--project <project-id>] [--id <id>] [--json] [<id>] --confirm [--cleanup|--stop-session] [--remove-worktree] [--force-worktree]  Permanently delete an issue
  issue image add [--project <project-id>] [--issue-id <issue-id>] [--path <file>] [<issue-id> <file>] [--json]  Attach an image to an issue
  issue image remove [--project <project-id>] [--issue-id <issue-id>] [--attachment-id <attachment-id>] [<issue-id> <attachment-id>] [--json]  Remove an image attachment from an issue
  issue document add [--project <project-id>] [--issue-id <issue-id>] [--path <file>] [<issue-id> <file>] [--json]  Attach a report/document to an issue
  issue document list [--project <project-id>] [--issue-id <issue-id>] [<issue-id>] [--json]  List report/document attachments for an issue
  issue document remove [--project <project-id>] [--issue-id <issue-id>] [--attachment-id <attachment-id>] [<issue-id> <attachment-id>] [--json]  Remove a document attachment from an issue
  issue dep add [--project <project-id>] --issue-id <issue-id> --depends-on-id <depends-on-id> [--type ...] [--force-parent-change] [--json]  Add a dependency edge
  issue dep remove [--project <project-id>] --issue-id <issue-id> --depends-on-id <depends-on-id> [--type ...] [--confirm] [--confirm-parent-orphan] [--json]  Remove a dependency edge
  issue dep bulk apply [--project <project-id>] --input <path> [--dry-run] [--json]  Apply dependency edge mutations
  issue bulk-create [--project <project-id>] [--impl <implementation>] --input <path> [--dry-run] [--json]  Create issues, epics, or nested children trees from JSON
  issue bulk-update [--project <project-id>] [--impl <implementation>] --input <path> [--dry-run] [--json]  Execute bulk update operations
  issue fanout [--project <project-id>] --input <path> [--apply] [--json]  Plan/apply a pre-authored nested issue tree from JSON
  issue fanout ready [--project <project-id>] --root <issue-id> [--json]  List runnable leaf issues under a fanout root
  issue fanout drift [--project <project-id>] --issue <issue-id> [--worktree <path>] [--json] [--fail-on-out]  Advisory ownership drift diagnostics
  mail <send|list|watch>  Mailbox event operations for orchestrator/worker coordination
  orchestrate <status|start|watch|prompt|message|complete-check|integrate|close-session>  Orchestration operations for parent issues
  config set <key> <value> [--project-dir <dir>]  Update project config
  sync [conflicts] [--all] [<directory>] [--project-dir <dir>] [--json]  Refresh issue tracker state for the current project or all worktrees
  prime                Print AI session primer with current issue context
  export               Export a snapshot (use --format json [--out <path>])
  daemon start         Start daemon and verify client attach
  daemon stop          Stop daemon for current runtime scope
  daemon restart       Force-restart the daemon and verify re-attach
  help                 Show this help message

Examples:
  az                   # Start TUI
  az session start az-123   # Start session for issue az-123
  az session attach az-123  # Attach to issue az-123's session
  az session stop az-123    # Stop issue az-123's session
  az session status         # Show all active sessions
  az session status az-123  # Show status for az-123
  az branch merge az-123    # Repair/manual merge into resolved target branch (normal close uses az issue close)
  az worktree create az-123 # Create an issue worktree without starting a session
  az issue list
  az issue list --query "runtime cache" --updated-after 2026-03-01
  az issue search --status open --query "runtime cache"
  az issue list --status in_progress
  az issue list --id az-1 --id az-2
  az issue list --deps
  az issue get --id az-123 --json
  az issue get-many --id az-123 --id az-456 --json
  az issue get-many --id az-123 --id az-456 --json --with-notes
  az issue get --id az-123
  az issue get --id az-123 --with-notes
  az issue check --id az-123
  az issue doctor --id az-123
  az issue create "New task"
  az issue create "Follow-up task"                # child under AZEDARACH_ISSUE_ID; no --impl needed for parentage
  az issue dep add --issue-id az-456 --depends-on-id az-123 --type parent-child  # attach an existing issue to another parent/root
  az issue create --impl go-bubbletea "Implementation-specific task"  # only assigns implementation metadata; still not parentage
  az issue split "Implement child task"           # auto-parent and launch isolated child worktree; merge explicitly later
  az issue create --deferred "Investigate later"  # deferred follow-up (defaults priority to P4)
  az issue update --id az-123 --status in_progress --title "Renamed task" --priority P1
  az issue update --id az-123 --status in_review  # ready for review/integration, not blocked
  az issue update --id az-123 --status closed
  az issue update --id az-123 --update-impl go-bubbletea
  az issue update --id az-123 --append-notes "Follow-up detail"
  az issue update --id az-123 --notes "Replacement notes"
  az issue close --id az-123        # integrates, cleans, then closes
  az issue close --id az-123 --force-worktree  # force worktree removal after integration
  az issue delete az-123 --confirm --cleanup
  az issue delete --id az-123 --confirm
  az issue image add --issue-id az-123 --path ./screenshot.png
  az issue image remove --issue-id az-123 --attachment-id 1a2b3c4d
  az issue document add --issue-id az-123 --path ./report.md
  az issue document list --issue-id az-123
  az issue dep add --issue-id az-456 --depends-on-id az-123 --type blocks
  az issue dep remove --issue-id az-456 --depends-on-id az-123 --type blocks --confirm
  az issue dep bulk apply --input ./dep-bulk.json --dry-run --json
  az issue bulk-create --impl go-bubbletea --input ./bulk-create.json  # supports nested children
  az issue bulk-update --impl go-bubbletea --input ./bulk-update.json --dry-run
  az issue fanout --input ./fanout.json
  az issue fanout --input ./fanout.json --apply
  az issue fanout ready --root az-123 --json
  az issue fanout drift --issue az-456 --worktree /tmp/az-456
  az mail send --parent az-123 --type dependency-ready --body "contract merged"
  az mail send --parent az-123 --issue az-456 --type worker-integration-ready --body "tests pass; ready for integration"
  az mail list --parent az-123 --since 40 --json
  az mail watch --parent az-123 --since 41 --jsonl
  az orchestrate status --root az-123 --since 41 --json
  az orchestrate prompt --root az-123 --issue az-456
  az orchestrate prompt --root az-123 --issue az-456 --coordination mailbox
  az orchestrate start --root az-123 --limit 4
  az orchestrate watch --root az-123 --since 41 --jsonl
  # Leave orchestrate watch running in another pane/session while workers are active; use --once only for diagnostic single polls.
  az orchestrate integrate --issue az-456      # Inspect worker evidence / repair guidance
  az orchestrate close-session --issue az-456  # Repair-only daemon stop; normal accepted-worker cleanup uses az issue close
  az orchestrate complete-check --root az-123
  az config set spec.enabled false
  az config set spec.enabled true --project-dir .
  az config set diagnostics.latencyTrace true
  az sync
  az sync --all
  az githooks install
  az githooks update
  az githooks run
  az githooks notify
  az githooks hook --hook pre-commit
  az gate az-123
  az dev gate az-123
  az dev start az-123
  az dev stop az-123
  az dev restart az-123
  az dev status az-123
  az dev list
  az project list
  az project add /path/to/project --name azedarach
  az project remove azedarach
  az project scripts status --json
  az impl list
  az impl delete --confirm ts-opentui
  az impl migrate ts-opentui default
  az operation list --limit 20
  az operation get --id op-123 --wait
  az operation logs --id op-123
  az operation cancel --id op-123 --reason "No longer needed"
  az log
  az log --no-follow --lines 100 daemon tui
  az ai install
  az ai status
  az ai status --target=codex --json
  az ai install --target=rulesync --issue az-123
  az ai install --target=claude,codex --issue az-123
  az ai uninstall
  az ai uninstall --target=claude,codex
  az ai migrate
  az ai hook run --agent=codex --json permission-request
  az tmux install-selector
  az tmux uninstall-selector
  az tmux selector
  az spec req list --query "daemon lifecycle recovery" --match any --limit 10
  az spec req get --id bfs-req-1
  az spec req create --id bfs-req-1 --title "Restore az spec grammar" --issue bgh
  az spec link add --issue bgh --req bfs-req-1 --role implements
  az spec read --issue bgh
  az spec lint --strict
  az spec parity --fail-on-out
  az decision record --title "Use SQLite for store" --rationale "Keep the store local and durable" --issue cgn
  az decision list --issue cgn
  az decision get --id dec-1 --with-links
  az decision link add --id dec-1 --req cgn-req-1 --relation applies-to
  az prime
  az export --format json
  az export --format json --out snapshot.json
  az daemon start
  az daemon stop
  az daemon restart

